{
  "name": "abzal-digital-business-card",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "npm run db:prepare && node dist/src/main.js",
    "db:prepare": "prisma migrate deploy && node dist/prisma/seed.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "vercel-build": "npm run build && node scripts/prepare-vercel.cjs"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@nestjs/apollo": "14.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "14.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@prisma/client": "6.19.0",
    "graphql": "^16.11.0",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
