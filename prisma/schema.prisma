generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Profile {
  id          String @id
  name        String
  description String
  links       ProfessionalLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfessionalLink {
  id        String @id
  label     String
  url       String
  sortOrder Int
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, sortOrder])
}

model Skill {
  id        String @id
  name      String
  sortOrder Int
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}

model Experience {
  id           String @id
  company      String
  position     String
  startDate    String
  endDate      String?
  sortOrder    Int
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]
  @@index([profileId, sortOrder])
}

model Achievement {
  id           String @id
  text         String
  sortOrder    Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  @@index([experienceId, sortOrder])
}

model Project {
  id          String @id
  name        String
  url         String
  sortOrder   Int
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, sortOrder])
}
